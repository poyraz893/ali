diff --git a/src/Files.App/Views/Layouts/BaseLayoutPage.cs b/src/Files.App/Views/Layouts/BaseLayoutPage.cs
index 31ca131..9ea6f15 100644
--- a/src/Files.App/Views/Layouts/BaseLayoutPage.cs
+++ b/src/Files.App/Views/Layouts/BaseLayoutPage.cs
@@ -172,6 +172,42 @@ namespace Files.App.Views.Layouts
 		}
 
 		private string jumpString = string.Empty;
+
+		public void JumpToPrefix(string prefix)
+		{
+			if (string.IsNullOrWhiteSpace(prefix))
+				return;
+
+			var shellViewModel = ParentShellPageInstance.GetRequiredShellViewModel();
+			var items = shellViewModel.FilesAndFolders.ToList();
+			var selectedItem = IsItemSelected ? SelectedItem : null;
+			var startIndex = selectedItem is null ? 0 : items.IndexOf(selectedItem) + 1;
+
+			ListedItem? match = items
+				.Skip(startIndex)
+				.Concat(items.Take(startIndex))
+				.FirstOrDefault(item => GetAlphabeticalName(item.Name).StartsWith(prefix, StringComparison.CurrentCultureIgnoreCase));
+
+			if (match is null)
+				return;
+
+			ItemManipulationModel.SetSelectedItem(match);
+			ItemManipulationModel.ScrollIntoView(match);
+			ItemManipulationModel.FocusSelectedItems();
+		}
+
+		private static string GetAlphabeticalName(string? name)
+		{
+			if (string.IsNullOrEmpty(name))
+				return string.Empty;
+
+			var firstLetterOrDigit = 0;
+			while (firstLetterOrDigit < name.Length && !char.IsLetterOrDigit(name[firstLetterOrDigit]))
+				firstLetterOrDigit++;
+
+			return name[firstLetterOrDigit..];
+		}
+
 		public string JumpString
 		{
 			get => jumpString;
